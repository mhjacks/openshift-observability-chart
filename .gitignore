# Created by https://www.toptal.com/developers/gitignore/api/helm,vim,linux
# Edit at https://www.toptal.com/developers/gitignore?templates=helm,vim,linux

### Helm ###
# Chart dependencies
**/charts/*.tgz

### Linux ###
*~

# temporary files which can be created if a process still has a handle open of a deleted file
.fuse_hidden*

# KDE directory preferences
.directory

# Linux trash folder which might appear on any partition or disk
.Trash-*

# .nfs files are created when an open file is removed but is still being accessed
.nfs*

### Vim ###
# Swap
[._]*.s[a-v][a-z]
# The swap pattern above also matches names such as .icon.svg.
!*.svg
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]

# Session
Session.vim
Sessionx.vim

# Temporary
.netrwhist
# Auto-generated tag files
tags
# Persistent undo
[._]*.un~

# End of https://www.toptal.com/developers/gitignore/api/helm,vim,linux

.vscode/
__pycache__/
*.py[cod]

# helm package writes the archive in the repo root. charts/*.tgz is above.
/*.tgz

# Keep credentials out of this repo.
values-secret.yaml
kubeconfig
kubeconfig.*
*.kubeconfig
